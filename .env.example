# Public env vars exposed to the Expo app at runtime
# Copy this file to .env and fill in values

# ArcGIS (GIS) API
# Base URL for your ArcGIS portal/feature service. Example for Daytona Beach:
EXPO_PUBLIC_GIS_BASE_URL=https://codb.maps.arcgis.com
# OAuth Bearer token for accessing your ArcGIS endpoints (if required)
EXPO_PUBLIC_GIS_TOKEN=
# OpenAI API
# Optional: default model name for OpenAI
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI API key fallback (will be used if a key isn't saved in SecureStore)
EXPO_PUBLIC_OPENAI_API_KEY=

# Optional: Google Maps API keys (recommended for Android)
EXPO_PUBLIC_ANDROID_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_IOS_GOOGLE_MAPS_API_KEY=
